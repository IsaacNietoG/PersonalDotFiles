[Unit]
Description=i3 Window Manager for Plasma
After=plasma-kwin_x11.service
Wants=plasma-kwin_11.service

[Service]
Type=simple
ExecStart=/usr/bin/i3
Restart=on-failure
RestartSec=1
Environment=QT_QPA_PLATFORM=xcb
Environment=XDG_CURRENT_DESKTOP=KDE
Environment=KDEWM=/usr/bin/i3

[Install]
WantedBy=graphical-session.target
